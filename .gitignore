# Függőségek — az npm a package-lock.json alapján bármikor újraépíti
node_modules/

# JetBrains IDE munkafájlok (gépspecifikus, nem a projekt része)
.idea/

# Gépspecifikus Claude Code kontextus (IP, user, útvonalak — publikus repóba nem való)
CLAUDE.local.md
# Claude Code helyi jogosultság-beállítások (session-specifikus, nem a projekt része)
.claude/settings.local.json

# Titkok: env fájlok soha nem kerülhetnek verziókezelésbe
.env
.env.*
# ...kivéve a placeholder-értékes mintafájlt, az dokumentáció
!.env.example
# ...és az éles build környezet-semleges beállítását (nincs benne titok)
!.env.production

# OS által generált fájlok
.DS_Store
