# Telepítés: sudo cp deploy/notes-export.service /etc/systemd/system/ &&
#            sudo systemctl daemon-reload
[Unit]
Description=Notes daily JSON export

# A ROBBANASI KORLAT AZ UJRAPROBALKOZASHOZ (l. a Restart= alatti indoklast).
# 9 inditas 3 oran belul: az elso + nyolc ujraprobalkozas 15 percenkent, azaz
# ket ora. A kilencedik utan a systemd nem indit tobbet — a unit HIBAS allapotban
# marad, es a napi Pi-allapotellenorzes 6. pontja megtalalja. A korlat nelkul egy
# valodi export-hiba orokke ismetlodne, csendben.
StartLimitIntervalSec=3h
StartLimitBurst=9

[Service]
Type=oneshot
WorkingDirectory=/opt/notes/backend
ExecStart=/usr/bin/node --env-file=.env scripts/daily-export.js

# UJRAPROBALKOZAS — egy ATMENETI hiba ne vigye el az adott nap pillanatkepet.
#
# A napi export EGYSZER fut ejfelkor, es az ELOZO napot vizsgalja. Ha egy atmeneti
# hiba (DB-akadozas, pillanatnyi eroforras-szuke) elszallasztja, es nincs ujra-
# probalkozas, akkor annak a napnak a pillanatkepe NEMAN elveszne — a kovetkezo
# futas mar a rakovetkezo napot menti. Ezert a unit magatol ujraprobal 15 percenkent
# (StartLimitBurst-ig), es egy mulo hiba utan a masodik-harmadik probalkozas sikerul.
#
# MIERT NEM ConditionPathExists= a mentes-konyvtarra: az NEM hibanak, hanem
# "kihagyva"-nak jelolne a futast, tehat a hiba is es a mentes is NEMAN maradna el.
# Itt pont az a cel, hogy a mentes MEGTORTENJEN, amint lehet, es a tartos hiba
# HANGOS legyen (StartLimitBurst kifutasa -> a Pi-allapotellenorzes 6. pontja).
#
# TORTENETI MEGJEGYZES: eredetileg ez az ujraprobalkozas a `/opt` kezi feloldasa
# miatt kellett — a regi, /opt-only titkositasnal a Persistent=true bepotlas
# aramszunet utan a meg fel nem oldott /opt-ba futott, es 226/NAMESPACE-szel elszallt.
# A TELJES rootfs-titkositas ota (l. CLAUDE.md) ez a verseny NEM lehetseges: a gep
# fel sem bootol feloldas nelkul, tehat mire a systemd a bepotlashoz er, a /opt mar
# csatolva van. Az ujraprobalkozas viszont a fenti, altalanos okbol MARAD.
Restart=on-failure
RestartSec=15min

# Ugyanaz a szolgáltatás-felhasználó, mint az appé (l. notes.service): nincs
# shellje, nincs sudója. A titkokat csoporton át olvassa (backend/.env =
# ubuntu:notes 640), a mentés-könyvtárnak pedig ő a TULAJDONOSA
# (/opt/backups/notes/daily = notes:ubuntu 2750) — a setgid bit miatt az
# általa írt fájlok az `ubuntu` csoportba kerülnek, tehát a laptop le tudja
# húzni őket. Ezt a deploy/setup-backup-permissions.sh állítja be.
User=notes
Group=notes

# --- ELSZIGETELÉS ---------------------------------------------------------
# Az indoklás a notes.service-ben áll, egy helyen. Az EGYETLEN eltérés, hogy ez
# a unit ÍR: a mentés-könyvtárat kimondottan írhatóvá kell tenni, mert a
# ProtectSystem=strict különben az egész fájlrendszert csak olvashatóvá teszi.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/opt/backups/notes/daily
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
# A mentés-fájlok a TULAJDONOSNAK és a CSOPORTNAK olvashatók (a laptop a
# csoporton át húzza le őket), másnak semmi.
UMask=0027
