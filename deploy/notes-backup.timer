# Telepítés: sudo cp deploy/notes-backup.* /etc/systemd/system/ &&
#            sudo systemctl daemon-reload && sudo systemctl enable --now notes-backup.timer
[Unit]
Description=Weekly Notes database backup, Sunday 01:00

[Timer]
OnCalendar=Sun *-*-* 01:00:00
Persistent=true

[Install]
WantedBy=timers.target
