# Telepítés: sudo cp deploy/notes.service /etc/systemd/system/ &&
#            sudo systemctl daemon-reload && sudo systemctl enable --now notes
[Unit]
Description=Notes app (Express API + static frontend)
After=network.target ferretdb.service
Wants=ferretdb.service

[Service]
WorkingDirectory=/opt/notes/backend
ExecStart=/usr/bin/node src/app.js
Restart=always

# KÜLÖN SZOLGÁLTATÁS-FELHASZNÁLÓ (2026-08-22). Korábban `ubuntu` volt — az a fő
# felhasználó, akinek JELSZÓ NÉLKÜLI sudo joga van, vagyis egy távoli kódfuttatás
# egyetlen lépéssel rootot adott volna. A `notes` rendszer-felhasználónak nincs
# shellje, nincs home-ja és nincs sudója; a projekt fájljait csak OLVASNI tudja
# (a kód továbbra is `ubuntu` tulajdonban van, hogy a fejlesztés ne törjön el).
# A titkokhoz csoporton át fér hozzá: backend/.env = ubuntu:notes 640.
User=notes
Group=notes

# Szabvány jelzés a Node-világ könyvtárainak, hogy éles futásról van szó (az
# Express például ilyenkor gyorsítótáraz és nem részletez hibákat).
# FONTOS: az app SEMMILYEN biztonsági döntést nem köt ehhez — a CORS névszerinti
# listából jön (CORS_ORIGINS), a hibaüzenetek titkolását pedig saját hibakezelő
# végzi (backend/src/app.js). Ha ez a sor egyszer elvész, semmi nem nyílik ki.
Environment=NODE_ENV=production

# --- ELSZIGETELÉS ---------------------------------------------------------
# Ez a blokk arra a kérdésre válaszol: "mit tud a folyamat, HA már fut valami
# idegen benne?" Nem az első védelmi vonal (az a bemenet-ellenőrzés), hanem a
# második: ez dönti el, mennyibe kerül egy jövőbeli hiba.

# Nem szerezhet több jogot, mint amivel indult (setuid bináris sem segít).
NoNewPrivileges=yes
# Saját /tmp: nem lát bele máséba, és nem hagy ott nyomot.
PrivateTmp=yes
PrivateDevices=yes

# A TELJES fájlrendszer csak olvasható. Az app SEHOVA nem ír: a naplója a
# journalba megy, a mentést külön unit (notes-export) írja. Ha valaha írnia
# kellene, ReadWritePaths= sorral kell KIMONDANI, hova — nem a védelem
# eltávolításával.
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Semmilyen kernel-képességre nincs szüksége: a 3001 nem privilegizált port.
CapabilityBoundingSet=
# Hálózat csak IP-n; az AF_UNIX a journalhoz és a névfeloldáshoz KELL.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

# MemoryDenyWriteExecute SZÁNDÉKOSAN NINCS ITT. Csábító volna, de a V8
# just-in-time fordítója írható ÉS futtatható memórialapokat használ — ezzel a
# kapcsolóval a Node el sem indulna. Ez nem elvi engedmény, hanem a futtatókörnyezet
# ténye; a helyére a fenti syscall-szűrő lép.

[Install]
WantedBy=multi-user.target
