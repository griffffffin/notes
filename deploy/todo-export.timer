# Telepítés: sudo cp deploy/todo-export.* /etc/systemd/system/ &&
#            sudo systemctl daemon-reload && sudo systemctl enable --now todo-export.timer
[Unit]
Description=Daily to-do JSON export at midnight (exports the previous day)

[Timer]
OnCalendar=*-*-* 00:00:00
Persistent=true

[Install]
WantedBy=timers.target
