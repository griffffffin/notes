# Telepítés: sudo cp deploy/notes-health.service deploy/notes-health.timer /etc/systemd/system/ &&
#            sudo systemctl daemon-reload && sudo systemctl enable --now notes-health.timer
#
# A health-check.sh-t NEM kell másolni: a service a /opt/to-do/deploy-ból
# futtatja, ahol a hozzá tartozó health.env (SMTP-adatok) is van. Így a szkript
# módosítása azonnal érvényes, nem kell újratelepíteni.
[Unit]
Description=Check the Notes app's health every minute

[Timer]
# Boot után adunk időt az appnak és az adatbázisnak elindulni, különben az első
# ellenőrzés még a normális indulás közben riasztana.
OnBootSec=2min
OnUnitActiveSec=1min

# SZÁNDÉKOSAN nincs Persistent=true — szemben az export/backup timerekkel.
# Azoknál a kimaradt futást be KELL pótolni (egy elmaradt mentés hiányzó adat).
# Az életjel viszont a JELENRŐL szól: hogy tíz perce épp nem válaszolt az app,
# azt utólag megkérdezni értelmetlen.

[Install]
WantedBy=timers.target
