# Telepítés: sudo cp deploy/todo-backup.* /etc/systemd/system/ &&
#            sudo systemctl daemon-reload && sudo systemctl enable --now todo-backup.timer
[Unit]
Description=Weekly to-do database backup, Sunday 01:00

[Timer]
OnCalendar=Sun *-*-* 01:00:00
Persistent=true

[Install]
WantedBy=timers.target
