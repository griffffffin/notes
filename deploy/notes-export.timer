# Telepítés: sudo cp deploy/notes-export.* /etc/systemd/system/ &&
#            sudo systemctl daemon-reload && sudo systemctl enable --now notes-export.timer
[Unit]
Description=Daily Notes JSON export at midnight (exports the previous day)

[Timer]
OnCalendar=*-*-* 00:00:00
Persistent=true

[Install]
WantedBy=timers.target
