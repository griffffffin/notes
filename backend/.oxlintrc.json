{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // ELTÉRÉS a frontend/.oxlintrc.json-tól: itt nincs "react" plugin (nincs
  // komponens és nincs hook), viszont van "node", "import" és "promise" — a
  // backend jellemző hibái (rossz modul-útvonal, elnyelt Promise, nem létező
  // core modul) ezekkel foghatók el. Az oxlint alapértelmezett plugin-listáját
  // a mező MEGADÁSA felülírja, nem bővíti, ezért az itt megtartott "oxc" és
  // "unicorn" is fel van sorolva.
  "plugins": ["oxc", "unicorn", "node", "import", "promise"],

  /* A lint `--deny-warnings`-szal fut (package.json): NÁLUNK A WARNING IS BUKÁS.
     Az oxlint warningra nulla kilépési kóddal lép ki, a CI pedig azt nézi — a
     warning-szintű szabályok tehát kapu nélkül maradnának. A hosszabb indoklás és
     a mérés a frontend .oxlintrc.json-jában áll, ott derült ki a lyuk. Itt is
     ingyenes volt: a bekapcsoláskor 78 fájl, 0 warning. */
  "rules": {
    "no-unused-vars": "error"
  }
}
