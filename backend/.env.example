# Másold le .env néven, és írd át a saját környezetedre.
# PORT/HOST: ahol az Express figyel (0.0.0.0 = a helyi hálózatról is elérhető).
# DATABASE: a FerretDB (vagy MongoDB) connection string — FerretDB v2-nél a
# hitelesítés a mögötte lévő PostgreSQL user adataival történik.
PORT=3001
HOST=0.0.0.0
DATABASE=mongodb://username:password@127.0.0.1:27017/notes
# A JWT-k aláírókulcsa — generálj sajátot: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
# CORS: mely IDEGEN origin-ok hívhatják az API-t, vesszővel elválasztva.
# Csak a fejlesztéshez kell: a Vite dev szerver külön porton fut, de ezt a
# backendet hívja. A buildelt frontendet ugyanez az Express adja (azonos
# origin), annak nincs szüksége CORS-ra — ha nem fejlesztesz, hagyd üresen.
CORS_ORIGINS=http://localhost:5173
# Kinek az adatait mentse a napi export. A saját felhasználód azonosítója
# (users._id). Üresen hagyva MINDEN felhasználó minden eleme exportálódik.
# Miért itt, és nem a kódban? Mert ez a TE telepítésed adata, nem a programé —
# ugyanaz az elv, amiért a szerver címe sincs a repóban.
EXPORT_USER_ID=
