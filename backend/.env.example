# Másold le .env néven, és írd át a saját környezetedre.
# PORT/HOST: ahol az Express figyel (0.0.0.0 = a helyi hálózatról is elérhető).
# DATABASE: a FerretDB (vagy MongoDB) connection string — FerretDB v2-nél a
# hitelesítés a mögötte lévő PostgreSQL user adataival történik.
PORT=3001
HOST=0.0.0.0
DATABASE=mongodb://username:password@127.0.0.1:27017/to-do
# A JWT-k aláírókulcsa — generálj sajátot: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
